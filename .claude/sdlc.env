# ============================================================
# sdlc.env — THE ONLY FILE YOU EDIT PER PROJECT
# Copy to .claude/sdlc.env and fill in for your stack.
# Every hook, agent, and skill reads commands from here.
# Never hard-code commands anywhere else.
# ============================================================

# --- Identity ---
PROJECT_NAME="agent-sentinel"
PRIMARY_LANGUAGE="python"          # python | typescript | go | terraform | mixed

# --- Toolchain commands (examples for iam-ai-tf style Python/uv) ---
FORMAT_CMD="uv run ruff format ."
LINT_CMD="uv run ruff check ."
TYPECHECK_CMD="uv run mypy ."               # set to "true" to skip
UNIT_TEST_CMD="uv run pytest -q -m 'not integration'"
INTEGRATION_TEST_CMD="uv run pytest -q -m integration"
COVERAGE_CMD="uv run pytest -q --cov --cov-fail-under=80"
# Verified: `docker build -f infra/docker/Dockerfile -t agent-sentinel:ci .`
# matches ci.yml's own "docker" job definition. NOT verified in this session
# -- the local Docker daemon isn't running here, and ci.yml itself has
# apparently never executed (its `branches: [main]` trigger doesn't match
# this repo's actual default branch, `master` -- separate bug, tracked in
# TASKS.md, not fixed here).
BUILD_CMD="docker build -f infra/docker/Dockerfile -t agent-sentinel:ci ."
# High-severity-only threshold: verified locally (`uv run bandit -r app -lll`)
# passes clean today. Deliberately not `-ll` (medium+): that surfaces 6
# pre-existing findings across 6 files needing individual security triage
# (url-open scheme audits, a bind-all-interfaces check) -- real work, out of
# scope for this fix, tracked in TASKS.md. This is real signal, not a no-op,
# and won't silently start failing on debt this change didn't introduce.
SECURITY_SCAN_CMD="uv run bandit -r app -lll"
# Still a placeholder. `infra/terraform/` is a documented skeleton (see
# README) with no state backend or CI credentials wired up. A
# `hashicorp/setup-terraform` step now exists and is SHA-pinned
# (agent-pipeline.yml:27, see docs/adr/0007-sha-pin-setup-terraform-action.md)
# and runs `terraform fmt -check`/`validate`, but a real `terraform plan`
# still needs cloud credentials this project doesn't have configured yet.
# Tracked in TASKS.md as a real follow-up.
IAC_PLAN_CMD="true"                         # e.g. "terraform plan -out=tfplan"

# TypeScript equivalent (reference):
#   FORMAT_CMD="npx prettier --write ."
#   LINT_CMD="npx eslint ."
#   UNIT_TEST_CMD="npx vitest run"

# --- Guardrails: hooks enforce these deterministically ---
# Paths frozen after spec sign-off (space-separated globs)
FROZEN_PATHS="spec/"
# Paths requiring the security-reviewer agent before merge
SENSITIVE_PATHS="infra/ policies/ .github/workflows/ .claude/hooks/"
# Commands PreToolUse hook hard-blocks (never runnable by any agent)
BLOCKED_COMMAND_PATTERNS="terraform apply|kubectl apply.*prod|az deployment.*prod|git push.*--force|rm -rf /|DROP TABLE"

# --- Debug loop circuit breaker ---
MAX_DEBUG_ITERATIONS=5

# --- Coverage & quality gates ---
MIN_COVERAGE=80

# --- Course-alignment additions (v2) ---
# Slopsquatting defense (Day 4): min package age on registry; whitelist bypasses
SLOPSQUAT_MIN_AGE_DAYS=30
SLOPSQUAT_WHITELIST=""              # space-separated exact package names

# MCP governance (Day 2): servers agents may call (must match .mcp.json keys)
MCP_ALLOWED_SERVERS=""

# HITL mode (Day 4 alignment knob):
#   two-gate  = strict template default (humans only at spec + prod)
#   per-phase = course-style ongoing HITL (pause for human at design approval
#               and pre-merge review as well)
HITL_MODE="two-gate"
